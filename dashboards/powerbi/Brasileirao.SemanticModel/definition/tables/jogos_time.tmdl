	partition jogos_time = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "jogos_time.csv"), [Delimiter = ",", Columns = 18, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.ReplaceValue(Cabecalho, "", null, Replacer.ReplaceValue, {"periodo_painel", "periodo_painel_ordem"}),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"jogo_id", type text}, {"temporada", Int64.Type}, {"rodada", Int64.Type}, {"data", type date}, {"periodo", type text}, {"periodo_painel", type text}, {"periodo_painel_ordem", Int64.Type}, {"bloco", type text}, {"bloco_ordem", Int64.Type}, {"bloco_tipo", type text}, {"resultado_jogo", type text}, {"resultado_ordem", Int64.Type}, {"time_id", type text}, {"adversario_id", type text}, {"lado", type text}, {"gols_pro", Int64.Type}, {"gols_contra", Int64.Type}, {"pontos", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
