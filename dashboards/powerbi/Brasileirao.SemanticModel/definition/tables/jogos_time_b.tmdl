	partition jogos_time_b = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "jogos_time_b.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Cabecalho,
				    Tipos = Table.TransformColumnTypes(Nulos, {{"jogo_id", type text}, {"temporada", Int64.Type}, {"data", type date}, {"time_id", type text}, {"adversario_id", type text}, {"lado", type text}, {"gols_pro", Int64.Type}, {"gols_contra", Int64.Type}, {"pontos", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
