/// Clubes da Série A de 2003 a 2025.
table times
	lineageTag: 238178f9-632b-51ea-9b0c-1b49a0b5b5ee

	column time_id
		dataType: string
		lineageTag: 2982d1a4-db51-5b1e-aa20-94f7d4be0102
		summarizeBy: none
		sourceColumn: time_id

		annotation SummarizationSetBy = User

	column nome
		dataType: string
		lineageTag: 1a0cb3c5-2267-58df-9426-962ddfae9923
		summarizeBy: none
		sourceColumn: nome

		annotation SummarizationSetBy = User

	column uf
		dataType: string
		lineageTag: 461f4f03-375a-5be9-93d8-de4b1b538b21
		summarizeBy: none
		sourceColumn: uf

		annotation SummarizationSetBy = User

	column primeira_temporada
		dataType: int64
		formatString: 0
		lineageTag: bf85a997-d0f3-5fd9-a4a3-c14ceccf1fe3
		summarizeBy: none
		sourceColumn: primeira_temporada

		annotation SummarizationSetBy = User

	column ultima_temporada
		dataType: int64
		formatString: 0
		lineageTag: 5b70d909-e838-5291-a981-715aa38f4738
		summarizeBy: none
		sourceColumn: ultima_temporada

		annotation SummarizationSetBy = User

	column temporadas_na_serie_a
		dataType: int64
