		sourceColumn: escudo
		dataCategory: ImageUrl

		annotation SummarizationSetBy = User

	partition times = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "times.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Cabecalho,
				    Tipos = Table.TransformColumnTypes(Nulos, {{"time_id", type text}, {"nome", type text}, {"uf", type text}, {"primeira_temporada", Int64.Type}, {"ultima_temporada", Int64.Type}, {"temporadas_na_serie_a", Int64.Type}, {"escudo", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
