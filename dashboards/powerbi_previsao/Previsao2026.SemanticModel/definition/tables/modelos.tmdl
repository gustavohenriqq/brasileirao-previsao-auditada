/// Um modelo no teste de 2026. O mercado é só referência e não tem replay da tabela.
table modelos
	lineageTag: ddfac53b-80da-5220-8be4-e170ca81b07c

	column modelo
		dataType: string
		lineageTag: bacdf80a-380d-5826-a2a5-1f55e9579734
		summarizeBy: none
		sourceColumn: modelo

		annotation SummarizationSetBy = User

	column rotulo
		dataType: string
		lineageTag: 9249cbe2-4be8-5623-9344-40dcaa943461
		summarizeBy: none
		sourceColumn: rotulo
		sortByColumn: ordem

		annotation SummarizationSetBy = User

	column papel
		dataType: string
		lineageTag: f9582565-6ad5-5d0b-ae41-209fea3e8084
		summarizeBy: none
		sourceColumn: papel

		annotation SummarizationSetBy = User

	column ordem
		dataType: int64
		formatString: 0
		lineageTag: a3de879a-9729-58ba-a2fa-c6a585170c95
		summarizeBy: none
		sourceColumn: ordem

		annotation SummarizationSetBy = User

	column rps
		dataType: double
		formatString: 0.000
		lineageTag: b290629c-a117-5fd2-9a7a-0d6c8acaa065
		summarizeBy: none
		sourceColumn: rps

		annotation SummarizationSetBy = User

	column log_loss
		dataType: double
		formatString: 0.000
		lineageTag: e5750e4d-d9fb-5bb2-9d93-3d5a296d6b07
		summarizeBy: none
		sourceColumn: log_loss

		annotation SummarizationSetBy = User

	column erro_pontos
		dataType: double
		formatString: 0.00
		lineageTag: 58bcffdb-4f3f-536d-8804-212142eabdf8
		summarizeBy: none
		sourceColumn: erro_pontos

		annotation SummarizationSetBy = User

	column erro_posicao
		dataType: double
		formatString: 0.00
		lineageTag: 952aed1a-75b5-5e62-a3e7-d143a4addd09
		summarizeBy: none
		sourceColumn: erro_posicao

		annotation SummarizationSetBy = User

	column cobertura_90
		dataType: double
		formatString: 0%
		lineageTag: 40867b6e-e447-5639-8fa7-453ec9758d26
		summarizeBy: none
		sourceColumn: cobertura_90

		annotation SummarizationSetBy = User

	partition modelos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "modelos.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.ReplaceValue(Cabecalho, "", null, Replacer.ReplaceValue, {"erro_pontos", "erro_posicao", "cobertura_90"}),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"modelo", type text}, {"rotulo", type text}, {"papel", type text}, {"ordem", Int64.Type}, {"rps", type number}, {"log_loss", type number}, {"erro_pontos", type number}, {"erro_posicao", type number}, {"cobertura_90", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
