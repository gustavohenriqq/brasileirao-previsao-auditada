	partition info = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "info.csv"), [Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Cabecalho,
				    Tipos = Table.TransformColumnTypes(Nulos, {{"simulacoes", Int64.Type}, {"jogos_disputados", Int64.Type}, {"jogos_restantes", Int64.Type}, {"jogos_total", Int64.Type}, {"ultimo_jogo", type date}, {"pendentes_sem_data", Int64.Type}, {"incerteza", type number}, {"jogos_teste", Int64.Type}, {"cortes_replay", Int64.Type}, {"cortes_texto", type text}, {"rodada_alvo_replay", Int64.Type}, {"gerado_em", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
