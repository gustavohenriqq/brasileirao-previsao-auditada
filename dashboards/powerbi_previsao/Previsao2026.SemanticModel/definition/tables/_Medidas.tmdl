	/// Cor de fundo pela probabilidade (violeta, neutro: não é destaque de aposta).
	measure 'Fundo Visitante vence' = VAR p = [Visitante vence] RETURN SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, BLANK (), p < 0.05, "#21215D", p < 0.25, "#2D297D", p < 0.5, "#3C35A6", p < 0.75, "#4B40CE", "#594AF5" )
		displayFolder: Cores
		lineageTag: 59e6ad3e-f050-5ec6-a4fe-e01090f2f302

	/// Cor da letra pelo fundo.
	measure 'Letra Visitante vence' = VAR p = [Visitante vence] RETURN SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#FFFFFF", p < 0.75, "#FFFFFF", "#FFFFFF" )
		displayFolder: Cores
		lineageTag: b2b740c9-63de-5663-89b9-fb6de8cacccb

	/// Cor da célula: tom da zona da posição, intensidade da chance.
	measure 'Fundo da posição' = VAR p = [Chance na posição] VAR z = SELECTEDVALUE ( posicoes[zona] ) RETURN SWITCH ( TRUE (), z = "Título", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, BLANK (), p < 0.05, "#343F30", p < 0.25, "#516226", p < 0.5, "#76911A", p < 0.75, "#9ABE0E", "#BDEA03" ), z = "G4", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, BLANK (), p < 0.05, "#343F30", p < 0.25, "#516226", p < 0.5, "#76911A", p < 0.75, "#9ABE0E", "#BDEA03" ), z = "G6", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, BLANK (), p < 0.05, "#343F30", p < 0.25, "#516226", p < 0.5, "#76911A", p < 0.75, "#9ABE0E", "#BDEA03" ), z = "Sul-Americana", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, BLANK (), p < 0.05, "#21215D", p < 0.25, "#2D297D", p < 0.5, "#3C35A6", p < 0.75, "#4B40CE", "#594AF5" ), z = "Meio", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, BLANK (), p < 0.05, "#292D51", p < 0.25, "#3C4065", p < 0.5, "#55597F", p < 0.75, "#6C7198", "#8489B2" ), z = "Z4", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, BLANK (), p < 0.05, "#3E2346", p < 0.25, "#642E50", p < 0.5, "#953D5D", p < 0.75, "#C44B6A", "#F35977" ) )
		displayFolder: Cores
		lineageTag: af669ab4-2153-5d7d-b374-f7f3da31e2ae

	/// Cor da célula: tom da zona da posição, intensidade da chance.
	measure 'Letra da posição' = VAR p = [Chance na posição] VAR z = SELECTEDVALUE ( posicoes[zona] ) RETURN SWITCH ( TRUE (), z = "Título", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#0B0D26", p < 0.75, "#0B0D26", "#0B0D26" ), z = "G4", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#0B0D26", p < 0.75, "#0B0D26", "#0B0D26" ), z = "G6", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#0B0D26", p < 0.75, "#0B0D26", "#0B0D26" ), z = "Sul-Americana", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#FFFFFF", p < 0.75, "#FFFFFF", "#FFFFFF" ), z = "Meio", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#FFFFFF", p < 0.75, "#0B0D26", "#0B0D26" ), z = "Z4", SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#FFFFFF", p < 0.75, "#FFFFFF", "#0B0D26" ) )
		displayFolder: Cores
