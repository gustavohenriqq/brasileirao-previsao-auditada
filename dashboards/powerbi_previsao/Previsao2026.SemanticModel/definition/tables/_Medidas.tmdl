	/// Cor da letra pelo fundo.
	measure 'Letra Empate' = VAR p = [Empate] RETURN SWITCH ( TRUE (), ISBLANK ( p ) || p < 0.001, "#FFFFFF", p < 0.05, "#FFFFFF", p < 0.25, "#FFFFFF", p < 0.5, "#FFFFFF", p < 0.75, "#FFFFFF", "#FFFFFF" )
		displayFolder: Cores
