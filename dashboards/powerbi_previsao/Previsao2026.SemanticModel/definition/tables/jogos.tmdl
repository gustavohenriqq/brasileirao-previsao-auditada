	partition jogos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "jogos.csv"), [Delimiter = ",", Columns = 13, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.ReplaceValue(Cabecalho, "", null, Replacer.ReplaceValue, {"data"}),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_jogo", type text}, {"ordem", Int64.Type}, {"rodada", Int64.Type}, {"data", type date}, {"quando", type text}, {"mandante", type text}, {"visitante", type text}, {"mandante_id", type text}, {"visitante_id", type text}, {"p_mandante", type number}, {"p_empate", type number}, {"p_visitante", type number}, {"placar_mais_provavel", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
