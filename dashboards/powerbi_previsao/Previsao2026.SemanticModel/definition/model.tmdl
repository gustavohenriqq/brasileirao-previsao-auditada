model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["PastaDados","times","posicoes","jogos","modelos","info"]

ref table times
ref table posicoes
ref table jogos
ref table modelos
ref table info
ref table _Medidas
