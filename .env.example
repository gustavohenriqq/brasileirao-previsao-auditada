# Copie para .env e ajuste. O .env não vai para o Git.

# Postgres local (docker compose). Porta 5433 de propósito.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=brasileirao
POSTGRES_USER=brasileirao
POSTGRES_PASSWORD=brasileirao

# football-data.org (plano gratuito: 10 chamadas por minuto).
# Cadastro em https://www.football-data.org/client/register
# Sem a chave, a ingestão pula essa fonte e avisa.
FOOTBALL_DATA_API_KEY=
